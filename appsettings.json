{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultSQLite": "Data Source=sample_company.db",
    "Examples": {
      "MySQL": "Server=localhost;Database=your_database;User=your_username;Password=your_password;",
      "PostgreSQL": "Host=localhost;Database=your_database;Username=your_username;Password=your_password;",
      "SQLite": "Data Source=path/to/your/database.db"
    }
  },
  "DatabaseSettings": {
    "AllowExternalConnections": true,
    "SupportedTypes": ["SQLite", "MySQL", "PostgreSQL"],
    "MaxConnections": 10
  }
}
